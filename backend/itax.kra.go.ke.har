            "text": "\r\n\r\n\r\n\r\n\r\n\r\n\r\n<!DOCTYPE html> \r\n<html>\r\n<head>\r\n <meta http-equiv=\"X-UA-Compatible\"    content=\"IE=edge\">\r\n\t<title> Kenya Revenue Authority</title>\r\n\r\n    <link rel=\"shortcut icon\" type=\"image/ico\" href=\"/KRA-Portal/themes/images/favicon.ico\" >\r\n\t\r\n\t<link rel=\"stylesheet\" href=\"/KRA-Portal/themes/styles/common/newHomeTemplate_kra.css\" type=\"text/css\" />\r\n\t<link rel=\"stylesheet\" href=\"/KRA-Portal/themes/styles/common/afterLoginHomeLayout_kra.css\" type=\"text/css\" />\t\r\n\t\r\n\r\n\r\n\t\r\n\r\n\t<script type='text/javascript' src=\"/KRA-Portal/dwr/engine.js\"></script>\r\n\t<script type='text/javascript' src=\"/KRA-Portal/dwr/util.js\"></script>\r\n\t<script>\r\n\t\tdwr.engine.setPreHook(function() {_showDynamicDiv()});\r\n\t\tdwr.engine.setPostHook(function() {_hideDynamicDiv()});\r\n\t</script>\r\n\r\n</head>\r\n\r\n\r\n\r\n<!--  <script type=\"text/javascript\">\r\n\tfunction PopUp(funCode)\r\n\t{\r\n\t\t document.getElementById(\"funCode\").value=funCode; \r\n\t\t setTimeout(\"ModalPopUp(funCode)\",2000);\r\n\t}\r\n\tfunction ModalPopUp(funCode) \r\n\t{\r\n\t\t//alert(document.getElementById(\"siteSurvey\").value);\r\n\t\tif(document.getElementById(\"siteSurvey\").value=='1')\r\n\t\t{\r\n\t\t\tdocument.getElementById(\"survey\").style.display=\"inherit\";\r\n\t\t\tdocument.getElementById(\"funCode\").value=funCode.value; \r\n\t\t\twindow.location=window.location+\"#survey\"; \r\n\t\t}\r\n\t\telse\r\n\t\t\tdocument.getElementById(\"survey\").style.display=\"none\";\r\n\t\t\t\r\n\t}\r\n\r\n\tfunction accepted()\r\n\t{\r\n\t\t\r\n\t\tvar funCode = document.getElementById(\"funCode\").value; \r\n\t\t\r\n// \t\tvar link=\"main.htm?actionCode=fetchQuestions&funCode=\"+funCode; \r\n// \t\tvar win=window.open(link,'_blank');\r\n// \t\twin.focus();\r\n// \t\tdocument.forms[0].action=\"siteSurvey.htm?actionCode=fetchQuestions&funCode=\"+funCode;\r\n// \t \tdocument.forms[0].submit();\r\n\r\n\t \tdocument.forms[0].action=\"main.htm?actionCode=fetchQuestions&funCode=\"+funCode;\r\n\t \tdocument.forms[0].target = '_blank';\r\n\t \tdocument.forms[0].submit();\r\n \r\n// \t \twindow.open(\"http://localhost:7080/KRAPortal/siteSurvey.htm?actionCode=fetchQuestions&funCode=\"+funCode, 'popupWindowName', 'dependent=yes, menubar=no,toolbar=no,resizable=yes,scrollbars=yes,status=yes,height=800,width=1000,left=40');\r\n\t\t\t\r\n// \t\twindow.open(\"main.htm?actionCode=fetchQuestions&funCode=\"+funCode);\t\r\n\t \twindow.location=window.location+\"#close\";\r\n\t \t\r\n\t}\r\n\tfunction notAccepted()\r\n\t{\r\n\t\twindow.location=window.location+\"#close\";\t\r\n\t}\r\n\t\r\n\t</script> -->\r\n\t\r\n<style>\r\n.btn{\r\nbackground:#ff1919;\r\nbackground-image:-webkit-linear-gradient(top,#ff1919,#c71414);\r\nbackground-image:-moz-linear-gradient(top,#ff1919,#c71414);\r\nbackground-image:-ms-linear-gradient(top,#ff1919,#c71414);\r\nbackground-image:-o-linear-gradient(top,#ff1919,#c71414);\r\nbackground-image:linear-gradient(to bottom,#ff1919,#c71414);\r\n-webkit-border-radius:28;\r\n-moz-border-radius:28;\r\nborder-radius:28px;\r\nfont-family:Arial;\r\ncolor:#fff;\r\nfont-size:10px;\r\npadding:5px 10px 5px 10px;\r\ntext-decoration:none;}\r\n</style>\r\n<body topmargin=\"0\">\r\n<script type=\"text/javascript\" src=\"/KRA-Portal/scripts/common/newHomeTemplate.js\"></script>\r\n<script type=\"text/javascript\" src=\"/KRA-Portal/scripts/common/commonValidationCombined.js\"></script>\r\n<script type=\"text/javascript\" src=\"/KRA-Portal/scripts/common/commonValidationCombined.js\"></script>\r\n<input type=\"hidden\" id=\"funCode\" name=\"funCode\" value=\"\"/>\r\n<input type=\"hidden\" id=\"siteSurvey\" name=\"siteSurvey\" value=\"1\"/>\r\n\t<!-- <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\"> -->\r\n<script type=\"text/javascript\" src=\"/KRA-Portal/scripts/common/common.js\"></script>\r\n\r\n<center>\r\n<div id='statusbar'>\r\n<table class=\"img\">\r\n<tr>\r\n<td id='imgtd'>\r\n<img src=\"/KRA-Portal/themes/images/pageLoader.gif\" height=\"60px\" width=\"60px\" alt=\"image is not supported.\"></img>\r\n</td>\r\n<td id='statuBarTd1' class=\"showProgressBar\"></td>\r\n</tr>\r\n</table>\r\n</div>\r\n</center>\r\n<div id=\"fadeBackground\"  class=\"fade_background\"></div>\r\n\r\n\r\n\t<!-- Main DIV Started  -->\r\n\t<div class=\"templateMainDiv\" align=\"center\">\r\n\t\t<!-- Header DIV Started  --> \r\n\t\t<div class=\"templateHeaderDiv\">\r\n\t\t\t\r\n\r\n<!-- Header Image DIV Started -->\r\n<div class=\"mainHeaderDIV\">\r\n\t<table class=\"mainHeaderTable\" id=\"header_TD\" cellspacing=\"0\" cellpadding=\"0\">\r\n\t\t<tr>\r\n\t\t\t<td>\r\n\t\t\t\t<img usemap=\"#KRALogo\" title=\"KRA\" src=\"/KRA-Portal/themes/images/P1Head.jpg\" height=\"122px\">\r\n\t\t\t\t\r\n\t\t\t\t<div class=\"templateContentDiv\">\r\n\t\t\t\t\t<table class=\"templateContentDivTable\">\r\n\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t<img title=\"KRA\" src=\"/KRA-Portal/themes/images/KRA_Diamond_Device.png\" height=\"30\" width=\"955px\">\r\n\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t</table>\r\n\t\t\t\t</div>\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<map name=\"KRALogo\">\r\n\t  \t\t\t\t<area shape=\"rect\" coords=\"62,26,300,118\" href=\"main.htm?actionCode=showOnlineServicesHomeLnclick\" />\r\n\t  \t\t\t</map>\r\n\t  \t\t\t\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t</table>\r\n</div>\r\n<!-- Header Image DIV ended -->\r\n\t\t</div>\r\n\t\t<!-- Header DIV Ended  -->\r\n\t\t<!-- Menu DIV Started  -->\r\n\t\t<div class=\"templateMenuDiv\">\r\n\t\t\t\r\n<!-- <!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\" \"http://www.w3.org/TR/html4/loose.dtd\"> -->\r\n<html>\r\n<head>\r\n\r\n<title>Insert title here</title>\r\n</head>\r\n<body>\r\n\r\n\r\n\r\n<!-- Menu DIV Started -->\r\n<div class=\"mainMenuDIV\"> <!-- Menu Main DIV -->\r\n\t<table class=\"mainMenuTable\" cellspacing=\"0\"  cellpadding=\"0\"> <!-- Menu Content Table -->\r\n\t\t<tr>\r\n\t\t\t<td>\r\n\t\t\t <!-- Main Menu JSP Included -->\r\n\t\t\t\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<html>\r\n\r\n<script type=\"text/javascript\">\r\n\r\nfunction OpenEform(taxType){\r\n\tdocument.leftMenu.action = \"main.htm?actionCode=getTemplatesToDownload&taxType=\"+taxType;\r\n\tdocument.leftMenu.submit();\r\n}\r\nfunction openSubject(docId){\r\n\tdocument.leftMenu.action='/KRA-Portal/manageUpload.htm?ACTION_TYPE=view&DOC_ID='+docId;\r\n\tdocument.leftMenu.submit();\r\n}\r\nfunction displaySessionTimeOut()\r\n{\r\n\tvar sessionExpired = false;\r\n\tif(sessionTimeOut!=null&&sessionTimeOut!=\"\")\r\n\t{\r\n\t\tif(sessionTimeOut>0)\r\n\t\t{\r\n\t\t\tif(isessionTime == null)\r\n\t\t\t{\r\n\t\t\t\tisessionTime=parseInt(sessionTimeOut/60);\r\n\t\t\t}\r\n\t\t\tsessionTimeOut=parseInt(sessionTimeOut);\r\n\t\t\tvar a=parseInt(sessionTimeOut/60);\r\n\t\t\tvar b=sessionTimeOut%60;\r\n\t\t\tif(a>0)\r\n\t\t\t{\r\n\t\t\t\tif(a == 2 && b == 0)\r\n\t\t        {\r\n\t\t            var dtCurr = new Date();\r\n\t\t            var iSec = parseInt(dtCurr.getTime()/1000);\r\n\t\t            var iMin = isessionTime - a;\r\n\t\t            alert(\"Dear User, you have not clicked on any link or button for the last \" + iMin + \" minutes. Please click on any link or button within next \" + a + \" minutes.\");\r\n\t\t            var dtCurrNew = new Date();\r\n\t\t            var iSecNew = parseInt(dtCurrNew.getTime()/1000);\r\n\t\t            var iDiff = iSecNew - iSec;\r\n\t\t            if(iDiff < sessionTimeOut)\r\n\t\t            \tsessionTimeOut = sessionTimeOut - iDiff;\r\n\t\t            else\r\n\t\t            \tsessionTimeOut = 1;\r\n\t\t        }\r\n\t\t\t\t\r\n\t\t\t\twindow.status=userinfo+\", Your session would expire in \"+a+\" minutes and \"+b+\" second(s).\";\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\tif(b>0)\r\n\t\t\t\t{\r\n\t\t\t\t\twindow.status=userinfo+\", Your session would expire in \"+b+\" second(s).\";\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tsessionExpired = true;\t\t\t\t\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif(!sessionExpired)\r\n\t\t\t{\r\n\t\t\t\tsessionTimeOut=sessionTimeOut-1;\r\n\t\t\t\twindow.setTimeout(\"displaySessionTimeOut()\",1000);\r\n\t\t\t}\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\tsessionExpired = true;\r\n\t\t}\r\n\t}\r\n\telse\r\n\t{\r\n\t\tsessionExpired = true;\r\n\t}\r\n\tif(sessionExpired)\r\n\t{\r\n\t\twindow.status=userinfo+\", Your session has expired. Please login again.\";\r\n\t\talert(userinfo+\", Your session has expired. Please login again.\");\r\n\t\tdocument.frmHeader.action = \"main.htm?actionCode=showSessionOutHomePage\";\r\n\t\tdocument.frmHeader.submit();\r\n\t}\r\n}\r\nfunction loadMyMigratePage()\r\n{\r\n\tif('INDI'=='NONINDI'){\r\n\t\tdocument.leftMenu.action =\"eRegIndi.htm?actionCode=loadMigrateNonIndi&taxPayerPin=A006711943R\";\r\n\t}else{\r\n\r\n\t\t//For PR#440 :Start\r\n\t\tif(document.getElementById(\"bDateEntered\") && null != document.getElementById(\"bDateEntered\"))\r\n\t\t{\r\n\t\t\tvar bDate=document.getElementById(\"bDateEntered\").value;\r\n\t\t\tif(bDate!=\"\")\r\n\t\t\t{\r\n\t\t\t\tdocument.leftMenu.action =\"eRegIndi.htm?actionCode=loadMigrateIndi&taxPayerPin=A006711943R&&bDateEntered=\" + bDate;\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\tdocument.leftMenu.action =\"eRegIndi.htm?actionCode=loadMigrateIndi&taxPayerPin=A006711943R\";\r\n\t\t\t}\r\n\t\t} //For PR#440 :End\r\n\t\telse\r\n\t\t{\r\n\t\t\tdocument.leftMenu.action =\"eRegIndi.htm?actionCode=loadMigrateIndi&taxPayerPin=A006711943R\";\r\n\t\t}\r\n\t\t\r\n\t}\r\n\r\n\tdocument.leftMenu.submit();\r\n}\r\n</script>\r\n<script>\r\n\r\n\r\nvar sessionTimeOut = 2400;\r\nvar isessionTime=null;\r\n</script>\r\n\r\n<script type=\"text/javascript\" src=\"/KRA-Portal/scripts/common/eService_General.js\"></script>\r\n\t\r\n\r\n\r\n\t<script type=\"text/javascript\" src=\"/KRA-Portal/scripts/common/eService_Taxpayer.js\"></script>\t\r\n\r\n<!-- Added for User Type UMSP :: START -->\r\n\r\n\r\n<!-- Added for User Type UMSP :: END -->\r\n\r\n\r\n<body>\r\n\r\n<form name=\"leftMenu\" method=\"POST\" class=\"mainMenuForm\">\r\n\r\n<!-- Hidden Input Fields Started  -->\r\n<input type=\"hidden\" name=\"operation\"/>\r\n<input type=\"hidden\" name=\"actionCode\"/>\r\n<input type=\"hidden\" name=\"flag\"/>\t\r\n<input type=\"hidden\" name=\"token_key\" value=\"null\"/>\r\n<!-- Hidden Input Fields Ended  -->\r\n\r\n<div  id=\"ddtopmenubar\" class=\"mattblackmenu\"> <ul><li><a class=\"mainMenu\" href=\"main.htm?actionCode=showOnlineServicesHomeLnclick\" rel=''>Home </a></li><li><a class=\"mainMenu\" href=\"#\" rel=\"Registration\">Registration</a></li><li><a class=\"mainMenu\" href=\"#\" rel=\"Returns\">Returns</a></li><li><a class=\"mainMenu\" href=\"#\" rel=\"Debt and Enforcement\">Debt and Enforcement</a></li><li><a class=\"mainMenu\" href=\"#\" rel=\"Payments\">Payments</a></li><li><a class=\"mainMenu\" href=\"#\" rel=\"Assessment Disputes\">Assessment Disputes</a></li><li><a class=\"mainMenu\" href=\"#\" rel=\"Refund\">Refund</a></li><li><a class=\"mainMenu\" href=\"#\" rel=\"Certificates\">Certificates</a></li><li><a class=\"mainMenu\" href=\"#\" rel=\"Useful Links\">Useful Links</a></li><li><a class=\"mainMenu\" href=\"#\" rel=\"e-Communication\">e-Communication</a></li><li><a class=\"mainMenu\" href=\"My Ledger\" rel=\"My Ledger\">My Ledger</a></li><li><a class=\"mainMenu\" href=\"javascript:logOutUser()\" rel=''>Logout</a></li></ul></div><ul id=\"Registration\" class=\"ddsubmenustyle\"><li> <a href=\"#\">Taxpayer Profile</a><ul><li> <a class=\"mainMenu\" href=\"javascript:showTaxpayerProfile();\">View Taxpayer Profile</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showReprintCertificate()\">Reprint PIN Certificate</a> </li></ul></li><li> <a href=\"#\">Amend PIN Details</a><ul><li> <a class=\"mainMenu\" href=\"javascript:showAmendmentForm();\">Amend Profile Details</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showTSOChng();\">Change Tax Service Office</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showAccountingPriodChng();\">Change Accounting Period</a> </li><li> <a class=\"mainMenu\" href=\"javascript:amendContactDetails()\">Update Contact Details</a> </li></ul></li><li> <a class=\"mainMenu\" href=\"javascript:showReactivationForm()\">e-Reactivation</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showDormaceForm()\">e-Dormance</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showCancellationForm()\">e-Cancellation</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showNewVatRegistration();\">Value Added Tax Application</a> </li><li> <a href=\"#\">Excise, Remmisions & Import Certificate</a><ul><li> <a class=\"mainMenu\" href=\"javascript:showExciseOperationLicenseHome();\">Excise Goods License</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showCamExciseAirtimeRegDtls();\">Excise Services License</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showCamExciseImportCertiRegDtls();\">Import Certificate Application</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showCamExciseDenaturedSpiritRegDtls();\">Remission of Excise Duty on Denatured Spirit</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showAppUsersofSpiritsIk();\">Spirits and Illuminating Kerosene License</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showCancelExciseLicense();\">Excise Goods License Cancellation</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showCamExciseAirtimeCnclDtls();\">Excise Services License Cancellation</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showCancSuspUsersofSpiritsIk();\">Spirits and Illuminating Kerosene License Cancellation</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadExcGoodsDestroyRegHome()\">Application for Destruction of Excisable Goods</a> </li></ul></li><li> <a href=\"#\">Withholding Tax</a><ul><li> <a class=\"mainMenu\" href=\"javascript:loadItWhtPaypointAmend()\">Withholding IT Agent Amendment</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadVATAmd()\">Withholding VAT Agent Amendment</a> </li><li> <a class=\"mainMenu\" href=\"javascript:tenantWithholdingAgentAmnd()\">Rent Income Withholding Agent Amendment</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadWhtVATCancellation()\">Withholding VAT Agent Cancellation</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadTenantWithAgCanc()\">Rent Income Withholding Agent Cancellation</a> </li></ul></li><li> <a href=\"#\">Monthly Rental Income</a><ul><li> <a class=\"mainMenu\" href=\"javascript:loadOptedOutLandlordRegForm()\">MRI Cancellation</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadPropertyRegErits()\">Register/Update Property in eRits</a> </li></ul></li><li> <a href=\"#\">Exemptions, Reliefs & Preferential Rates</a><ul><li> <a class=\"mainMenu\" href=\"javascript:loadITExemptReg();\">IT Exemption</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadTaxReliefReg();\">Tax Relief Scheme</a> </li><li> <a class=\"mainMenu\" href=\"javascript:agentDetailsPage()\">Registration for Preferential Tax Rates</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadVatWhtExemptReg();\">VAT Withholding Exemption</a> </li><li> <a class=\"mainMenu\" href=\"javascript:agentDetailsPageCnclPreferentialTax()\">Preferential Tax Rate Cancellation</a> </li></ul></li><li> <a href=\"#\">Tax Agents and Representatives</a><ul><li> <a class=\"mainMenu\" href=\"javascript:loadTaxRepresentReg()\">Tax Representative Registration</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showTaxRepCancellation();\">Tax Representative Cancellation</a> </li></ul></li><li> <a class=\"mainMenu\" href=\"javascript:loadOptedOutTotRegDtls()\">Turnover Tax Cancellation</a> </li></ul><ul id=\"Returns\" class=\"ddsubmenustyle\"><li> <a class=\"mainMenu\" href=\"javascript:showEReturns();\">File Return</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showEReturnsAmendment();\">File Amended Return</a> </li><li> <a class=\"mainMenu\" href=\"javascript:viewEReturns()\">View Filed Return</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showNilReturn();\">File Nil Return</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadITREmpIncomeOnly();\">ITR For Employment Income Only</a> </li><li> <a href=\"#\">Simplified Returns</a><ul><li> <a class=\"mainMenu\" href=\"javascript:loadITREmpIncomeOnly();\">ITR For Employment Income Only</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showExciseRtnSimpServicesHome();\">Excise (Services Only)</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showTOTRtnSimplifiedHome();\">Turnover Tax (TOT)</a> </li></ul></li><li> <a href=\"#\">Income Tax Return Adjustments</a><ul><li> <a class=\"mainMenu\" href=\"javascript:loadManualEtimsInvoices()\">Manual & Non-eTims/TIMS Invoices</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadAccountingAccrualAdjst()\">Accounting & Accrual Adjustments</a> </li></ul></li></ul><ul id=\"Debt and Enforcement\" class=\"ddsubmenustyle\"><li> <a class=\"mainMenu\" href=\"javascript:loadLegacyBalanceReport()\">Reprint Legacy Migration Balance Report</a> </li></ul><ul id=\"Payments\" class=\"ddsubmenustyle\"><li> <a class=\"mainMenu\" href=\"javascript:showPaymentRegForm()\">Payment Registration</a> </li><li> <a class=\"mainMenu\" href=\"javascript:viewMakePaymentForm()\">Make Payment</a> </li><li> <a class=\"mainMenu\" href=\"javascript:consultPayments()\">Consult Payments</a> </li><li> <a class=\"mainMenu\" href=\"javascript:consultCGTReturn()\">Consult CGT Return</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showNewPaymentPlan();\">Apply Payment Plan (New)</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadSetoffAdvancePaymentForm()\">Setoff Advance Payment/Offset Overpayment</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadSetOffLegacyVoucher()\">Setoff Legacy Credit Voucher</a> </li></ul><ul id=\"Assessment Disputes\" class=\"ddsubmenustyle\"><li> <a class=\"mainMenu\" href=\"javascript:loadReqObjApp();\">Objection Application</a> </li><li> <a href=\"#\">Notice of intention to Appeal</a><ul><li> <a class=\"mainMenu\" href=\"javascript:loadAppealAppLC();\">Appeal to the Local Committee/ Tribunal</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadAppealAppHC();\">Appeal to the High Court</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadAppealAppAC();\">Appeal to the Court of Appeal</a> </li></ul></li><li> <a class=\"mainMenu\" href=\"javascript:loadReqObjAppWhtVat();\">Objection Application WHT VAT</a> </li><li> <a href=\"#\">Notice of Intention to Appeal WHT VAT</a><ul><li> <a class=\"mainMenu\" href=\"javascript:loadAppealAppWhtVatLC();\">Appeal to the Local Committee/Tribunal</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadAppealAppWhtVatHC();\">Appeal to the High Court</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadAppealAppWhtVatAC();\">Appeal to the Court of Appeal</a> </li></ul></li></ul><ul id=\"Refund\" class=\"ddsubmenustyle\"><li> <a class=\"mainMenu\" href=\"javascript:showVATRefund();\">VAT</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showITRefund()\">Income Tax</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showExciseRefund()\">Excise</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showStampDutyRefund()\">Stamp Duty</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showLandRentRefund()\">Land Rent</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showInventoryRefund()\">Inventory</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showRefundsTaxPaidInError();\">Refund on Tax Paid In Error</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showRefundsOrOffsetOverpaidTax();\">Refund or Offset Overpaid Taxes</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showTOTRefund()\">Turnover Tax</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showInstallmentAdjustmentVoucher();\">Installment Adjustment Voucher</a> </li></ul><ul id=\"Certificates\" class=\"ddsubmenustyle\"><li> <a class=\"mainMenu\" href=\"javascript:reprintWHTCerti()\">Reprint Withholding Certificate</a> </li><li> <a class=\"mainMenu\" href=\"javascript:viewVATWHtCertiCnclForm()\">Withholding VAT Certificate Cancellation</a> </li><li> <a class=\"mainMenu\" href=\"javascript:viewMRIWHtCertiCnclForm()\">Rental Income Withholding Certificate Cancellation</a> </li><li> <a class=\"mainMenu\" href=\"javascript:viewWHtCertiCnclForm()\">Withholding Certificate Cancellation</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showGenerateTCC();\">Apply for Tax Compliance Certificate(TCC)</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showReprintTCC();\">Consult and Reprint TCC</a> </li><li> <a class=\"mainMenu\" href=\"javascript:consultAndReprintVATWHTCerti()\">Reprint VAT Withholding Certificate</a> </li><li> <a class=\"mainMenu\" href=\"javascript:consultAndReprintMRIWHTCerti()\">Reprint Rental Income Withholding Certificate</a> </li></ul><ul id=\"Useful Links\" class=\"ddsubmenustyle\"><li> <a class=\"mainMenu\" href=\"javascript:openFAQ()\">FAQ</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadPage();javascript:showProgressbar1();\">Change Password</a> </li><li> <a class=\"mainMenu\" href=\"javascript:openTrackStatus()\">Track Status of Application</a> </li><li> <a class=\"mainMenu\" href=\"javascript:viewTaxtypeAssign()\">Generate Tax Type Specific Password</a> </li><li> <a class=\"mainMenu\" href=\"javascript:pinchecker();\">PIN Checker</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showTCCChecker();\">TCC/Exemption Checker</a> </li><li> <a class=\"mainMenu\" href=\"javascript:whtChecker();\">WHT Checker</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showQueries1()\">Report Problem</a> </li><li> <a class=\"mainMenu\" href=\"javascript:loadReprintAckDtlsForm()\">Consult and Reprint Acknowledgement Receipt and Certificates</a> </li></ul><ul id=\"e-Communication\" class=\"ddsubmenustyle\"><li> <a class=\"mainMenu\" href=\"javascript:viewReceivedMessages();\">Received Messages</a> </li><li> <a class=\"mainMenu\" href=\"javascript:viewSentMessages();\">View Sent Messages</a> </li></ul><ul id=\"My Ledger\" class=\"ddsubmenustyle\"><li> <a class=\"mainMenu\" href=\"javascript:showGeneralLedgerFormWithParaNew()\">General Ledger</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showGeneralLedgerForm()\">General Ledger Report</a> </li><li> <a class=\"mainMenu\" href=\"javascript:showGeneralLedgerFormTR()\">General Ledger Report for Tax Rep</a> </li></ul>\r\n<script type=\"text/javascript\">\r\n\tddlevelsmenu.setup(\"ddtopmenubar\", \"topbar\");\r\n\tvar userinfo=\"JOSPHAT MBUTHIA NGUGI\";\r\n\tdisplaySessionTimeOut();\r\n\tfunction setHomePageThis(){if (document.all){document.body.style.behavior='url(#default#homepage)';document.body.setHomePage('http://www.revenue.go.ke');}else{alert(\"This feature is not supported by your browser.\\nPlease visit your browser's help section for assistance on how to set homepage.\");}}\r\n</script>\r\n</form>\r\n\t\r\n</body>\r\n</html> \r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t</table>\r\n</div>\r\n<!-- Menu DIV Ended -->\r\n\r\n\r\n</body>\r\n</html>\t\r\n\t\t</div>\r\n\t\t<!-- Menu DIV Ended  -->\r\n\t\t\r\n\t\t<!-- Banner DIV Started  -->\r\n\t\t<div class=\"templateBannerDiv\">\r\n\t\t\t\r\n\r\n\r\n\r\n\r\n\r\n<form name=\"frmHeader\" method=\"post\" style=\"margin-bottom: 0px\">\r\n\r\n\r\n<!-- Hidden Input Fields started -->\r\n<input type=\"hidden\" name=\"siteLanguage\" id=\"siteLanguage\">\r\n<!-- Hidden Input Fields ended -->\r\n\r\n<!-- Header Links DIV Started -->\r\n<div class=\"mainBannerDIV\">\r\n\t<table class=\"mainBannerTable\" cellspacing=\"0\" cellpadding=\"0\">\r\n\t\t<tr>\r\n\t\t\t<!-- Welcome User Message Started  -->\r\n\t\t\t<td class=\"textAlignCenter\" valign=\"middle\">\r\n\t\t\t\t<div class=\"textAlignCenter\">\r\n\t\t\t\t\r\n\t\t\t\t<img class=\"guest-gif\" src=\"/KRA-Portal/themes/images/guest.gif\"/>\r\n\t\t\t\t&nbsp;&nbsp;<b>Welcome&nbsp;JOSPHAT MBUTHIA NGUGI&nbsp;(A006711943R)</b>\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t&nbsp;-&nbsp;<b>Last Login&nbsp;:&nbsp;JUL 06, 2026  06:53:52</b>\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t</div>\t\t\t\r\n\t\t\t</td>\r\n\t\t\t<!-- Welcome User Message Ended  -->\r\n\t\t</tr>\r\n\t</TABLE>\r\n</div>\r\n<!-- Header Links DIV Ended -->\r\n\r\n \r\n<script>\r\n\t//convertURL();   //uncomment this when sending war\r\n</script>\r\n</form>\r\n\t\t</div>\r\n\t\t<!-- Banner DIV Ended  -->\r\n\t\t<!-- Content DIV Started  -->\r\n\t\t<div class=\"templateContentDiv\">\r\n\t\t\t<table class=\"templateContentDivTable\">\r\n\t\t\t\t<tr>\r\n\t\t\t\t\t<td class=\"templateContentDivTableMainPanel\">\r\n\t\t\t\t\t\t<!-- <img title=\"KRA\" src=\"/KRA-Portal/themes/images/KRA_Diamond_Device.png\" height=\"30\" width=\"955\">  -->\r\n\t\t\t\t\t\t<div class=\"templateContentDivTableMainPanelDiv\">\r\n\t\t\t\t\t\t\t<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n\r\n<link rel=\"stylesheet\"  href='/KRA-Portal/themes/styles/common/siteSurvey.css' type=\"text/css\"/>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=ISO-8859-1\" />\r\n\r\n<style type=\"text/css\">\r\n.asterisk {\r\n\tsize: 2px;\r\n\tcolor: red;\r\n}\r\n\r\n.mandatoryField {\r\n\tfont-family: Calibri;\r\n\tfont-size: 12px;\r\n\ttext-align: left;\r\n\tcolor: RED;\r\n\tfont-weight: bold;\r\n}\r\n</style>\r\n<script type=\"text/javascript\">\r\nfunction downloadPmtReceipt(){\r\n\tvar actionURL=\"paymentRegistration.htm?actionCode=loadPDF\";\r\n    document.paymentReceipt.action=actionURL;\r\n    document.paymentReceipt.submit();    \r\n}\r\nfunction downloadPinCertificate(){\r\n\tif(null!=document.getElementById('obligId').value && (document.getElementById('obligId').value=='LL' || document.getElementById('obligId').value=='SBP'))\r\n\t{\r\n\t\tvar navigationString =\"/KRA-Portal/eCerificate.htm?actionCode=loadPdfCounty&noticeId=403692450\";\r\n\t\twindow.open(navigationString,\"new\");\r\n\t}\r\n\telse{\r\n\t window.open(\"/KRA-Portal/eCerificate.htm?actionCode=loadReceipt&noticeId=403692450&noticeName=2020260003444567\",\"new\");\r\n\t}\r\n}\r\n\r\nfunction downloadAckReceipt(){\r\n\t\r\n\t window.open(\"/KRA-Portal/eCerificate.htm?actionCode=loadReceipt&noticeId=403692450\",\"new\");\r\n}\r\n\r\nfunction downloadCgtAckReceipt(noticeId){\r\n\t\r\n\t window.open(\"/KRA-Portal/eCerificate.htm?actionCode=loadReceipt&noticeId=\"+noticeId,\"new\");\r\n}\r\n\r\nfunction downloadVoucherReceipt(noticeId){\r\n\t\r\n\t window.open(\"/KRA-Portal/eCerificate.htm?actionCode=loadReceipt&noticeId=\"+noticeId,\"new\");\r\n}\r\n\r\nfunction funGoToPayment(){\r\n\tvar url = \"paymentRegistration.htm?actionCode=loadPRFormFrmRtn\";\r\n\tdocument.paymentReceipt.action= url;\r\n\tdocument.paymentReceipt.submit();\r\n\treturn true;\r\n}\r\nfunction goToPaymentOL()\r\n{  \r\n\tvar actionURL=\"paymentRegistration.htm?actionCode=beforeLoadPRForm\";\r\n   \tdocument.paymentReceipt.action=actionURL;\r\n   \tdocument.paymentReceipt.submit();   \r\n   \r\n}\r\nfunction goToStampDutyApprovalForm(){\r\n\tvar actionURL=\"paymentRegistration.htm?actionCode=loadStampDutyApprovalForm\";\r\n   \tdocument.paymentReceipt.action=actionURL;\r\n   \tdocument.paymentReceipt.submit();\t\r\n}\r\nfunction goToPrePaymentPage()\r\n{\r\n\tvar url = \"paymentRegistration.htm?actionCode=beforeLoadPRForm\";\r\n\tdocument.paymentReceipt.action= url;\r\n\tdocument.paymentReceipt.submit();\r\n\treturn true;\t\r\n\t\r\n}\r\nfunction goBackToVatWhtPrePaymentPage()\r\n{\r\n\t\t\t \r\n\t\t\tvar url=\"paymentRegistration.htm?actionCode=showVATWitholdingPrePaymentRegForm\";\r\n\t\t\tdocument.paymentReceipt.action= url;\r\n\t\t\tdocument.paymentReceipt.submit();\r\n\t\t\treturn true;\r\n\t\t\r\n}\r\nfunction goToMakePaymntPage()\r\n{\r\n\tvar url = \"paymentRegistration.htm?actionCode=loadMakePaymentForm\";\r\n\tdocument.paymentReceipt.action= url;\r\n\tdocument.paymentReceipt.submit();\r\n\treturn true;\r\n}\r\n</script>\r\n\r\n</head>\r\n\r\n<body onload=\"javascript:PopUp('pmt');\" >\r\n<input type=\"hidden\" name=\"obligId\" id=\"obligId\" value=\"8\"/>\r\n\r\n<!-- if navigate flag is set \"P\" means back navigation is on payment page -->\r\n\t<div class=\"textAlignLeft\"> \r\n\t\t<table>\r\n\t\t\t<tr class=\"youAreHere\">\r\n\t\t\t\t\t\r\n \r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\nfunction getBack()\r\n{\r\n   \r\n   \r\n   var siteMapJsp=\"\";\r\n   var linkFrom=\"\";\r\n   //alert('');\r\n   siteMapJsp='';\r\n   linkFrom='';\r\n   if(siteMapJsp!=null && siteMapJsp!=\"\" && siteMapJsp=='siteMap')\t \r\n\t   window.location.href =\"/KRA-Portal/main.htm?actionCode=showSiteMap\";\t \r\n   else if(linkFrom!=null && linkFrom!=\"\" && linkFrom=='OS') //OS - Online Services Page\r\n\t   window.location.href =\"/KRA-Portal/main.htm?actionCode=showOnlineServices&viewType=static\";\r\n   else if(linkFrom!=null && linkFrom!=\"\" && linkFrom=='LP') //LP - Login Page\r\n\t   window.location.href = \"/KRA-Portal/main.htm?actionCode=loadOnlineServicesPage\";\r\n   else\t \r\n\t   getBackHome();\r\n}\r\nfunction getBackHome()\r\n{\r\n\t\r\n\t//alert('eServices');\r\n\tvar viewType='eServices';\r\n\tif(viewType == \"static\")\r\n\t\twindow.location.href = \"/KRA-Portal/main.htm?actionCode=showHomePageLnclick\";\r\n\telse\r\n\t\twindow.location.href = \"/KRA-Portal/main.htm?actionCode=showOnlineServicesHomeLnclick\";\r\n}\r\n</script>\r\n<!-- Bread Crumb - General Message/Link - starts -->\r\n<td>\r\n\t&nbsp;&nbsp;<a href=\"#\" onClick=\"javascript:getBackHome();\"><img src=\"/KRA-Portal/themes/images/home.png\" alt=\"Home\"/></a>\r\n</td>\r\n\r\n<!-- Bread Crumb ends -->\r\n\t\t\t\t\t<td>&gt;&gt;&nbsp;<a href = \"#\" onclick=\"