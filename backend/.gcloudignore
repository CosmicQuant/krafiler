# Cloud Build ignore file — prevents stale build artifacts from being sent to the build context
# Paths are relative to the backend/ directory because builds are submitted from here.
node_modules/
dist/
tmp/
logs/
uploads/output/

.env
.env.*
!.env.example

*.log
*.tmp
*.temp

receipts/
dump.rdb
redis/dump.rdb
redis/*.pdb
redis/redis.zip

.DS_Store
Thumbs.db
*.sqlite
*.sqlite-journal
*.rdb

test_output/
*.zip

.archive/
temp-*.tsx
