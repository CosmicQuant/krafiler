{
    "name": "kra-filing-backend",
    "version": "1.0.0",
    "description": "KRA iTax Nil Return Filing — Express API & BullMQ Worker",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "worker": "ts-node-dev --respawn --transpile-only src/workers/kraFilingWorker.ts",
        "tot": "ts-node-dev --respawn --transpile-only src/scripts/file-kra-tot-return.ts",
        "start": "node dist/server.js",
        "start:worker": "node dist/workers/kraFilingWorker.js",
        "start:tot": "node dist/scripts/file-kra-tot-return.js"
    },
    "dependencies": {
        "@types/sharp": "^0.31.1",
        "bullmq": "^5.7.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.3.1",
        "express-validator": "^7.1.0",
        "helmet": "^7.1.0",
        "ioredis": "^5.3.2",
        "playwright": "^1.59.1",
        "playwright-extra": "^4.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "sharp": "^0.34.5",
        "tesseract.js": "^7.0.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.12.7",
        "@types/uuid": "^9.0.8",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.4.5"
    }
}