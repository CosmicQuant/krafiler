{
    "name": "kra-filing-backend",
    "version": "1.0.0",
    "description": "KRA iTax Nil Return Filing — Express API & BullMQ Worker",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "worker": "ts-node-dev --respawn --transpile-only src/workers/kraFilingWorker.ts",
        "tot": "ts-node-dev --respawn --transpile-only src/scripts/file-kra-tot-return.ts",
        "generate:tot": "ts-node src/scripts/kra-tot-generator.ts",
        "start": "node dist/server.js",
        "start:worker": "node dist/workers/kraFilingWorker.js",
        "start:tot": "node dist/scripts/file-kra-tot-return.js"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@types/sharp": "^0.31.1",
        "adm-zip": "^0.5.17",
        "archiver": "^7.0.1",
        "better-sqlite3": "^12.9.0",
        "bullmq": "^5.7.0",
        "cors": "^2.8.6",
        "csv-parser": "^3.2.0",
        "csv-writer": "^1.6.0",
        "dotenv": "^16.4.5",
        "exceljs": "^4.4.0",
        "express": "^4.19.2",
        "express-rate-limit": "^7.3.1",
        "express-validator": "^7.1.0",
        "fast-csv": "^5.0.5",
        "helmet": "^7.1.0",
        "ioredis": "^5.3.2",
        "kysely": "^0.28.17",
        "multer": "^2.1.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "pino-roll": "^4.0.0",
        "playwright": "^1.59.1",
        "playwright-extra": "^4.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "sharp": "^0.34.5",
        "sqlite": "^5.1.1",
        "sqlite3": "^6.0.1",
        "tesseract.js": "^7.0.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/archiver": "^7.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/multer": "^2.1.0",
        "@types/node": "^20.12.7",
        "@types/sqlite3": "^3.1.11",
        "@types/uuid": "^9.0.8",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.4.5"
    }
}
