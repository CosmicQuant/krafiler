# ─── JWT (Employee Portal) ────────────────────────────────────────────────────────
# Secret for signing employee portal JWT tokens
JWT_SECRET=replace-with-a-long-random-jwt-secret

# ─── Encryption ────────────────────────────────────────────────────────────────
# Must be >= 32 random characters. Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ENCRYPTION_SALT=replace-with-a-random-unique-salt-string

# ─── Pub/Sub ───────────────────────────────────────────────────────────────────
# GCP Pub/Sub is used for filing jobs in production. Set to 'true' to enable.
USE_PUBSUB=true
PUBSUB_TOPIC=filing-jobs

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Set to 'true' ONLY for local development while Firebase Auth is not configured.
# NEVER enable this in production.
DEV_BYPASS_AUTH=false

# ─── Express Server ────────────────────────────────────────────────────────────
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000
NODE_ENV=development

# ─── Receipt Storage ───────────────────────────────────────────────────────────
# Optional: override the default receipts directory (default: project-root/receipts)
RECEIPTS_DIR=

# ─── Playwright ────────────────────────────────────────────────────────────────
# Set to 'false' to show the browser window (headed mode) for debugging
PLAYWRIGHT_HEADLESS=false

# ─── Gemini Vision ─────────────────────────────────────────────────────────────
# Used to read the KRA Security Stamp arithmetic captcha from a lossless PNG
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# ─── AWS S3 (Cloud Storage) ────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=kra-receipts-bucket

# ─── Notifications ─────────────────────────────────────────────────────────────
# Webhook endpoint to call once receipt is ready
WEBHOOK_URL=https://your-service.example.com/webhooks/kra-receipt
WEBHOOK_SECRET=your-webhook-signing-secret
# OR for email via SES:
SES_FROM_EMAIL=noreply@yourdomain.com

# ─── Resend Email API ───────────────────────────────────────────────────────────
# Primary email provider for payslips/P9s. Get your API key from
# https://resend.com/api-keys. The webhook secret is shown when you create a
# webhook endpoint in the Resend dashboard.
RESEND_API_KEY=your-resend-api-key
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret
RESEND_FROM_EMAIL=payroll@yourdomain.com

# ─── Email (Mass Emailing) ─────────────────────────────────────────────────────
# Fallback SMTP credentials for sending payslips/P9s to employees.
# Supports any SMTP provider: SendGrid, Amazon SES, Mailgun, etc.
# Leave unset to use JSON transport (dev mode, no actual sending).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password-or-api-key
EMAIL_FROM=payroll@yourcompany.com

# ─── Paystack (Subscriptions) ──────────────────────────────────────────────────
# Test key for development, live key for production.
# Get yours from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
